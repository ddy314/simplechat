{
  "name": "simplechat",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "check": "npm run check --workspaces --if-present",
    "dev": "npm run dev --workspace @simplechat/web",
    "dev:api": "npm run dev --workspace @simplechat/api",
    "dev:web": "npm run dev --workspace @simplechat/web",
    "format": "npm run format --workspaces --if-present"
  }
}

