{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simplechat-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-12",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ORIGIN": "https://simplechat-web.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "simplechat-db",
      "database_id": "208abf08-5560-43c1-be10-a82820944163"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MESSAGE_BLOB",
      "bucket_name": "simplechat-message-blobs"
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
